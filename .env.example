# ---------- Database ----------
# Local Postgres, Supabase, Neon or Railway connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/worklog?schema=public"
# Supabase/Neon poolers also need a direct URL for migrations:
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/worklog?schema=public"

# ---------- Auth.js ----------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Full public URL of the app. Required in production.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------- Google OAuth ----------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- Local development ----------
# Lets you sign in with just an email address, without Google credentials.
# Ignored entirely when NODE_ENV=production. Never enable on a deployed app.
ENABLE_DEV_LOGIN="true"

# ---------- Defaults ----------
DEFAULT_TIMEZONE="Asia/Jakarta"
DEFAULT_CURRENCY="IDR"
SEED_USER_EMAIL="rian@example.com"
